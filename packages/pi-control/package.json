{
	"name": "@mcowger/pi-control",
	"version": "0.3.2",
	"description": "Action-based filesystem policies for pi tool calls.",
	"repository": {
		"type": "git",
		"url": "https://github.com/mcowger/pi-plugins.git",
		"directory": "packages/pi-control"
	},
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"files": [
		"src",
		"skills",
		"examples",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "bun test",
		"check": "bun run lint && bun run typecheck",
		"lint": "bunx biome check src tests",
		"typecheck": "bunx tsc --noEmit",
		"format": "bunx biome format --write src tests",
		"format:check": "bunx biome format src tests"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"@vscode/tree-sitter-wasm": "^0.3.1",
		"minimatch": "^10.2.5",
		"strip-json-comments": "^5.0.3"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.80.2",
		"@types/bun": "^1.3.14",
		"@biomejs/biome": "^2.5.1",
		"typescript": "^6.0.3",
		"@earendil-works/pi-tui": "^0.80.2"
	},
	"homepage": "https://github.com/mcowger/pi-plugins/tree/main/packages/pi-control#readme",
	"bugs": {
		"url": "https://github.com/mcowger/pi-plugins/issues"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.2",
		"@earendil-works/pi-tui": ">=0.80.2"
	}
}
