{
	"name": "@mcowger/pi-suppress-providers",
	"author": "Matt Cowger",
	"version": "0.1.5",
	"description": "Pi extension that limits which providers appear in model selection by suppressing env vars for non-enabled providers",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"pi-suppress",
		"provider",
		"suppress",
		"enabledProviders"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mcowger/pi-plugins.git",
		"directory": "packages/pi-suppress-providers"
	},
	"homepage": "https://github.com/mcowger/pi-plugins/tree/main/packages/pi-suppress-providers#readme",
	"bugs": {
		"url": "https://github.com/mcowger/pi-plugins/issues"
	},
	"engines": {
		"bun": ">=1.0"
	},
	"files": [
		"index.ts",
		"src/",
		"README.md"
	],
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"format": "bunx biome format --write index.ts src",
		"format:check": "bunx biome format index.ts src",
		"lint": "bunx biome check index.ts src",
		"pack:dry-run": "npm pack --dry-run",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@earendil-works/pi-ai": "0.80.6",
		"@earendil-works/pi-coding-agent": "0.80.6",
		"bun-types": "1.3.14"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "0.80.6",
		"@earendil-works/pi-coding-agent": "0.80.6"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
