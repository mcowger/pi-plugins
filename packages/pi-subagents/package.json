{
	"name": "@mcowger/pi-subagents",
	"author": "Matt Cowger",
	"version": "0.1.0",
	"description": "Personal in-process Pi subagents: one main-agent tool call spawns exactly one child with a locked model/thinking, a depth ceiling, and a frozen tool policy.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"subagents",
		"subagent"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/mcowger/pi-plugins.git",
		"directory": "packages/pi-subagents"
	},
	"homepage": "https://github.com/mcowger/pi-plugins/tree/main/packages/pi-subagents#readme",
	"bugs": {
		"url": "https://github.com/mcowger/pi-plugins/issues"
	},
	"engines": {
		"bun": ">=1.0"
	},
	"files": [
		"index.ts",
		"src/",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck",
		"lint": "bunx biome check index.ts src tests",
		"typecheck": "bunx tsc --noEmit",
		"format": "bunx biome format --write index.ts src tests",
		"format:check": "bunx biome format index.ts src tests",
		"test": "bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.99.0",
		"@earendil-works/pi-coding-agent": ">=0.99.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@earendil-works/pi-ai": "0.99.0",
		"@earendil-works/pi-coding-agent": "0.99.0",
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.3"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	}
}
